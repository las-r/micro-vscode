{
    "name": "micro-vscode",
    "displayName": "micro",
    "description": "VSCode language support for the micro programming language.",
    "version": "0.2.0",
    "publisher": "las-r",
    "repository": {
        "type": "git",
        "url": "https://github.com/las-r/micro-vscode"
    },
    "engines": {
        "vscode": "^1.146.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "micro",
                "aliases": [
                    "micro",
                    "micro"
                ],
                "extensions": [
                    ".mic",
                    ".micro"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "micro",
                "scopeName": "source.micro",
                "path": "./syntaxes/micro.tmLanguage.json"
            }
        ]
    }
}