{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "micro",
    "scopeName": "source.micro",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings"  },
        { "include": "#numbers" },
        { "include": "#function-definition" },
        { "include": "#keywords" },
        { "include": "#function-call" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#identifiers" }
    ],
    "repository": {
        "comments": {
            "name": "comment.line.double-slash.micro",
            "match": "//[^\\n]*"
        },
        "strings": {
            "name": "string.quoted.double.micro",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.micro",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "name": "constant.numeric.micro",
            "match": "\\b\\d+(?:\\.\\d+)?\\b"
        },
        "function-definition": {
            "match": "\\b(func)\\s+([a-zA-Z_]\\w*)",
            "captures": {
                "1": { "name": "storage.type.function.micro" },
                "2": { "name": "entity.name.function.micro" }
            }
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.flow.micro",
                    "match": "\\b(if|else|while|break|return|end)\\b"
                },
                {
                    "name": "keyword.control.import.micro",
                    "match": "\\b(import)\\b"
                },
                {
                    "name": "storage.type.function.micro",
                    "match": "\\bfunc\\b"
                }
            ]
        },
        "function-call": {
            "match": "\\b([a-zA-Z_]\\w*)(?=\\s*\\()",
            "captures": {
                "1": { "name": "entity.name.function.call.micro" }
            }
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.micro",
                    "match": "==|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.logical.micro",
                    "match": "&&|\\|\\||!"
                },
                {
                    "name": "keyword.operator.bitwise.micro",
                    "match": "[~&|^]"
                },
                {
                    "name": "keyword.operator.arithmetic.micro",
                    "match": "[+\\-*/%]"
                },
                {
                    "name": "keyword.operator.assignment.micro",
                    "match": "="
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.comma.micro",
                    "match": ","
                },
                {
                    "name": "punctuation.separator.colon.micro",
                    "match": ":"
                },
                {
                    "name": "punctuation.definition.parenthesis.micro",
                    "match": "[()]"
                },
                {
                    "name": "punctuation.definition.bracket.micro",
                    "match": "[\\[\\]]"
                }
            ]
        },
        "identifiers": {
            "name": "variable.other.micro",
            "match": "\\b[a-zA-Z_]\\w*\\b"
        }
    }
}